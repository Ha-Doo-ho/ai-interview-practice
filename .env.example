DATABASE_URL=sqlite:///./interview.db
COOKIE_SECURE=false

AI_LIVE_ENABLED=true
PAID_AI_ENABLED=true

# 3.5 모델 통일
AI_PROVIDER=gemini
AI_MODEL_ID=gemini-3.6-flash
AI_ALLOWED_MODEL_IDS=gemini-3.6-flash

# 발급받은 Gemini API 키
AI_PROVIDER_KEY=

AI_MAX_INPUT_TOKENS=12000
AI_SYNTHESIS_MAX_INPUT_TOKENS=80000
AI_MAX_OUTPUT_TOKENS=2000
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=0
AI_MAX_CALLS_PER_RUN=9

AI_MAX_COST_MICROUSD=500000
AI_INPUT_RATE_MICROUSD_PER_MILLION_TOKENS=750000
AI_OUTPUT_RATE_MICROUSD_PER_MILLION_TOKENS=3750000

# MySQL target example, using a dedicated development/test database:
# DATABASE_URL=mysql+pymysql://interview:YOUR_PASSWORD@127.0.0.1:3306/interview?charset=utf8mb4
# HTTPS deployment requires COOKIE_SECURE=true and a separate deployment review.
